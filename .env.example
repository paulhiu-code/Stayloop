# --- Frontend (Vite) — set in Vercel, baked at build time ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Optional locally when running npm run server on port 4000:
# VITE_API_BASE_URL=http://localhost:4000

# --- Server (Vercel /api routes) — NEVER prefix secrets with VITE_ ---
DATABASE_URL=postgresql://user:password@host:5432/postgres
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SITE_URL=https://stay-loop.co
ALLOWED_REDIRECT_ORIGINS=https://stay-loop.co,https://www.stay-loop.co

# --- Local Express dev only (npm run server) ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Optional: cron + email (Express host or future Vercel cron) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CRON_SECRET=your-cron-secret
# HEALTH_CHECK_SECRET=your-health-check-secret

# --- Optional: database TLS (production serverless) ---
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...

# --- Email (Resend) — Supabase Edge Function secrets, not Vercel frontend ---
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=StayLoop <noreply@stay-loop.co>
# EMAIL_REPLY_TO=support@your-domain.com
