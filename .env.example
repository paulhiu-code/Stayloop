# --- Frontend (Vite) — set in Vercel, baked at build time ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Optional: only needed for local dev when API runs on another port (e.g. localhost:4000)
# VITE_API_BASE_URL=http://localhost:4000

# --- Server (Vercel serverless /api routes) — NEVER prefix secrets with VITE_ ---
DATABASE_URL=postgresql://user:password@host:5432/postgres
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Local Express dev only (npm run server) ---
PORT=4000
CORS_ORIGIN=*
