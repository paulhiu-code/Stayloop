# =============================================================================
# StayLoop secrets template — copy to ../secrets.local.env and fill in ONCE
# =============================================================================
# cp docs/secrets.local.template.env secrets.local.env
#
# Then copy each value to the stores listed in docs/ENVIRONMENT.md:
#   - Cursor Cloud Agents → Secrets
#   - GitHub → Settings → Secrets and variables → Actions
#   - Vercel → Project → Environment Variables
#   - Supabase → Edge Functions → Secrets
#
# ROTATE FIRST (were exposed in chat): SUPABASE_ACCESS_TOKEN, SUPABASE_SERVICE_ROLE_KEY,
#   SUPABASE_DB_PASSWORD, VERCEL_TOKEN
# =============================================================================

# --- Supabase CLI / deploy (ROTATE) ---
SUPABASE_ACCESS_TOKEN=REPLACE_ME
SUPABASE_DB_PASSWORD=REPLACE_ME
SUPABASE_PROJECT_REF=glmzeapxusbsuhixhbqw

# --- Supabase keys ---
# Service role: ROTATE (required). Anon: optional rotate (public in browser).
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_URL=https://glmzeapxusbsuhixhbqw.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.glmzeapxusbsuhixhbqw.supabase.co:5432/postgres

# --- Vercel deploy (ROTATE token) ---
VERCEL_TOKEN=REPLACE_ME
VERCEL_ORG_ID=team_YZZ17u8JTl0DtRyoSUixjqmc
VERCEL_PROJECT_ID=prj_4j9ygg0MIvJeN8PUoqZVxs2MEAko

# --- Vercel frontend (Production) ---
VITE_SUPABASE_URL=https://glmzeapxusbsuhixhbqw.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME
VITE_API_BASE_URL=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- App URLs (not secrets) ---
SITE_URL=https://stay-loop.co
CORS_ORIGIN=https://stay-loop.co
ALLOWED_REDIRECT_ORIGINS=https://stay-loop.co

# --- Stripe server (set when Stripe is configured) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cron / automation ---
CRON_SECRET=REPLACE_ME_RANDOM
PMS_CRON_SECRET=REPLACE_ME_RANDOM
EMAIL_CRON_SECRET=

# --- Email (Supabase Edge Function secrets) ---
RESEND_API_KEY=
EMAIL_FROM=StayLoop <noreply@stay-loop.co>
EMAIL_REPLY_TO=support@stay-loop.co

# --- Optional ---
PLATFORM_FEE_PERCENT=10
PORT=4000
NODE_ENV=production

# --- Supabase Edge Function aliases (some functions read these names) ---
STAYLOOP_SUPABASE_URL=https://glmzeapxusbsuhixhbqw.supabase.co
STAYLOOP_SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SAME_AS_SERVICE_ROLE
STAYLOOP_SUPABASE_ANON_KEY=REPLACE_ME_SAME_AS_ANON
STAYLOOP_PMS_CRON_SECRET=REPLACE_ME_SAME_AS_PMS_CRON_SECRET
