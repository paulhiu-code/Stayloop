# =============================================================================
# StayLoop — copy to repo root as .env.local (gitignored)
# =============================================================================
# cp docs/secrets.local.template.env .env.local
#
# Fill ONLY after rotating keys in Supabase/Vercel dashboards.
# NEVER commit .env.local or paste values in Cursor chat.
#
# After filling, push to Vercel:
#   VERCEL_TOKEN=<new-token> node --env-file=.env.local scripts/configure-vercel-env.mjs
# Then redeploy: Vercel → stayloop → Deployments → Redeploy
# =============================================================================

# --- Supabase (rotate anon + service_role + DB password in dashboard first) ---
SUPABASE_URL=https://glmzeapxusbsuhixhbqw.supabase.co
VITE_SUPABASE_URL=https://glmzeapxusbsuhixhbqw.supabase.co
SUPABASE_ANON_KEY=PASTE_NEW_ANON_KEY_HERE
VITE_SUPABASE_ANON_KEY=PASTE_SAME_ANON_KEY_HERE

# DB password from Supabase → Database → Reset database password
DATABASE_URL=postgresql://postgres:PASTE_NEW_DB_PASSWORD@db.glmzeapxusbsuhixhbqw.supabase.co:5432/postgres

# --- Stripe (rotate in Stripe Dashboard only if keys were ever shared) ---
STRIPE_SECRET_KEY=PASTE_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=PASTE_STRIPE_WEBHOOK_SECRET
VITE_STRIPE_PUBLISHABLE_KEY=PASTE_STRIPE_PUBLISHABLE_KEY

# --- App URLs (not secrets — do not change) ---
SITE_URL=https://stay-loop.co
ALLOWED_REDIRECT_ORIGINS=https://stay-loop.co,https://www.stay-loop.co

# --- CLI / automation (fill after creating NEW tokens — not stored on Vercel) ---
