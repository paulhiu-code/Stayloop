SUPABASE_ACCESS_TOKEN=PASTE_NEW_SBP_TOKEN
SUPABASE_SERVICE_ROLE_KEY=PASTE_NEW_SERVICE_ROLE_KEY
VERCEL_TOKEN=PASTE_NEW_VERCEL_TOKEN
